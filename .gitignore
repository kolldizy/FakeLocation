# Dependencies and environments
node_modules/
.venv/

# Python bytecode
__pycache__/
*.py[cod]

# Build output and packaged artifacts
release/

# Generated reports and screenshots — they contain device identifiers,
# so they stay on the machine that produced them.
docs/reports/

# Local scratch: capture output, ad-hoc probes, smoke JSON. Machine paths and
# device identifiers live here, so nothing in it is ever staged.
tmp/

# Logs and OS clutter
*.log
Thumbs.db
Desktop.ini
